{
  "name": "stellar-club", "version": "1.0.0", "private": true,
  "description": "星曜电竞：uni-app H5 / Vue 3 运营后台 / 可替换 Mock API",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mobile": "npm run dev --workspace @stellar/mobile",
    "dev:admin": "npm run dev --workspace @stellar/admin",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "vue-tsc --noEmit -p apps/admin/tsconfig.json && vue-tsc --noEmit -p apps/mobile/tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "build:mp-weixin": "npm run build:mp-weixin --workspace @stellar/mobile"
  },
  "workspaces": ["apps/*", "packages/*"],
  "devDependencies": {"typescript": "~5.7.3", "vue-tsc": "^2.2.0", "tsx": "^4.19.2"},
  "engines": {"node": ">=20"}
}
