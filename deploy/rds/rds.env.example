# Install on the server as /etc/norman-acceptance/rds.env, root:root 0600.
# Create the account and its password yourself in the RDS console.
RDS_HOST=rm-REPLACE.mysql.rds.aliyuncs.com
RDS_USERNAME=norman_service
RDS_PASSWORD=
# Create norman_acceptance with utf8mb4 before migrating.
# Download these public CA files from this RDS instance's SSL settings:
# /etc/norman-rds-ca/rds-ca.pem
# /etc/norman-rds-ca/rds-ca.jks (official store password: apsaradb)
