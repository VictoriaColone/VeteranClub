# Copy to .local/server.env at repository root for local development, or inject through deployment secrets.
# Generate each key independently: openssl rand -base64 32
CLUB_ENCRYPTION_KEY=
CLUB_HASH_KEY=
DB_URL=jdbc:mysql://127.0.0.1:3306/norman_club?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC&sslMode=REQUIRED
DB_USERNAME=norman_app
DB_PASSWORD=
CLUB_DEVELOPMENT=false
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://club.example.com
# Only include the exact reverse proxy IPs you control; never trust all addresses.
TRUSTED_PROXIES=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
JOBS_ENABLED=true
SMS_PROVIDER=disabled
ALIYUN_SMS_SIGN=
ALIYUN_SMS_TEMPLATE=
# Prefer an instance RAM role. The official SDK also supports server-only environment credentials:
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
SMS_DAILY_LIMIT=200
# Development ONLY: CLUB_DEVELOPMENT=true, COOKIE_SECURE=false, SMS_PROVIDER=outbox
# SMS_OUTBOX=/absolute/private/path/sms-outbox.jsonl
